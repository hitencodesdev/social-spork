# Server Configuration
PORT=5000
NODE_ENV=development
API_SECRET_KEY=spork_secret_ingest_key_2026

# Database Configuration
# Local MongoDB or MongoDB Atlas URI (e.g. mongodb://localhost:27017/social_spork or mongodb+srv://...)
MONGODB_URI=mongodb://localhost:27017/social_spork

# Meta WhatsApp Cloud API Configuration
# Options: 'mock' (for local simulation & testing) or 'live' (production)
WHATSAPP_MODE=mock
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=mock_phone_number_id
WHATSAPP_ACCESS_TOKEN=mock_permanent_system_user_token
WHATSAPP_WABA_ID=mock_waba_account_id
WHATSAPP_WEBHOOK_VERIFY_TOKEN=social_spork_webhook_verify_2026
WHATSAPP_TEMPLATE_NAME=restaurant_complaint_alert_v1
WHATSAPP_TEMPLATE_LANG=en

# Google Sheets Integration (Optional)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# App Base URL (For deep-linking in notifications)
APP_BASE_URL=http://localhost:5173
